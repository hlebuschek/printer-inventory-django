# Скопируйте в .env.docker и заполните. Используется docker-compose.stack.yml.

SECRET_KEY=CHANGE_ME_LONG_RANDOM_STRING
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000
BASE_URL=http://localhost:8000
USE_HTTPS=False

# PostgreSQL (сервис db в compose)
DB_NAME=printer_inventory
DB_USER=postgres
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_HOST=db
DB_PORT=5432

# Redis (сервис redis в compose)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Первичный суперпользователь для /admin — создаётся автоматически при первом старте.
# Через /admin добавьте Keycloak-логины в whitelist (Access → Allowed users),
# либо в контейнере: python manage.py manage_whitelist add <username>
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_PASSWORD=CHANGE_ME_ADMIN_PASSWORD
DJANGO_SUPERUSER_EMAIL=admin@localhost

# Keycloak / OIDC (обязательно: без него вход в систему невозможен)
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=printer-inventory
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_VERIFY_SSL=True

# Часовой пояс
TIME_ZONE=Asia/Irkutsk
CELERY_TIMEZONE=Asia/Irkutsk

# Опрос принтеров
POLL_INTERVAL_MINUTES=60
HTTP_CHECK=True

# Интеграция GLPI (опционально)
GLPI_API_URL=
GLPI_APP_TOKEN=
GLPI_USER_TOKEN=

# SMTP для supplies_report (опционально)
EMAIL_HOST=
EMAIL_PORT=25
DEFAULT_FROM_EMAIL=noreply@localhost
SUPPLIES_REPORT_AUTOSEND_ENABLED=False

# Регистрация USB-агентов (опционально)
USB_AGENT_REGISTRATION_KEY=
