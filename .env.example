################################################################################
# ШАБЛОН НАСТРОЕК ОКРУЖЕНИЯ
# Скопировать в .env и заполнить: cp .env.example .env
# .env читается автоматически (load_dotenv в settings.py), export не нужен.
################################################################################

################################################################################
# DJANGO
################################################################################

# Секретный ключ (обязательно заменить! сгенерировать:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
SECRET_KEY=REPLACE_ME_WITH_SECURE_KEY

# Режим отладки: True только на dev
DEBUG=False

# За HTTPS-прокси: включает Secure-cookie и редиректы
USE_HTTPS=False

# Разрешённые хосты и доверенные origins для CSRF (через запятую)
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=http://localhost:8000,https://localhost:8000

# Внешний адрес приложения (используется в ссылках писем)
BASE_URL=http://localhost:8000

# Таймзоны Django и Celery (обычно совпадают)
TIME_ZONE=Asia/Irkutsk
CELERY_TIMEZONE=Asia/Irkutsk

################################################################################
# POSTGRESQL
################################################################################

DB_NAME=printer_inventory
DB_USER=postgres
# Пароль со спецсимволами брать в одинарные кавычки: DB_PASSWORD='p$ss'
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

################################################################################
# REDIS (0=кэш, 1=сессии, 2=inventory, 3=Celery — номера БД зашиты в settings)
################################################################################

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

################################################################################
# KEYCLOAK / OIDC
################################################################################

KEYCLOAK_SERVER_URL=http://localhost:8080
KEYCLOAK_REALM=printer-inventory
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# False — если у Keycloak самоподписанный сертификат
OIDC_VERIFY_SSL=True

################################################################################
# ПОЧТА: ОТПРАВКА (SMTP)
# По умолчанию console-backend: письма печатаются в консоль, наружу не уходят.
# Для реальной отправки:
#   EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# Локальный стенд GreenMail (docker в ~/PycharmProjects/mail-test):
#   EMAIL_HOST=localhost, EMAIL_PORT=3025, TLS/SSL=False
################################################################################

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=25
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
EMAIL_TIMEOUT=20
DEFAULT_FROM_EMAIL=noreply@localhost

################################################################################
# ПОЧТА СЕРВИС-ДЕСКА: ЗАЯВКИ ПОДРЯДЧИКУ И ПРИЁМ ОТВЕТОВ (IMAP)
# SERVICE_DESK_EMAIL — адрес «от кого» уходят заявки и куда подрядчик отвечает.
# Без SERVICE_DESK_IMAP_HOST приём писем не ставится в расписание Celery.
# Локальный стенд GreenMail: host=localhost, port=3143, SSL=False,
#   user=servicedesk@company.test, пароль любой.
################################################################################

SERVICE_DESK_EMAIL=
SERVICE_DESK_IMAP_HOST=
SERVICE_DESK_IMAP_PORT=993
SERVICE_DESK_IMAP_USER=
SERVICE_DESK_IMAP_PASSWORD=
SERVICE_DESK_IMAP_SSL=True
SERVICE_DESK_IMAP_FOLDER=INBOX
# Как часто забирать ящик, в минутах (на тестовом стенде удобно 1)
SERVICE_DESK_FETCH_MINUTES=5

################################################################################
# ОТЧЁТЫ ПО РАСХОДНИКАМ
################################################################################

# Автоотправка по расписанию (требует настроенный SMTP)
SUPPLIES_REPORT_AUTOSEND_ENABLED=False

################################################################################
# ОПРОС ПРИНТЕРОВ / GLPI-AGENT
################################################################################

# Путь к бинарям glpi-agent (пусто — поиск автоматически)
# Linux: /usr/local/bin | macOS: /Applications/GLPI-Agent/bin | Windows: C:\Program Files\GLPI-Agent
GLPI_PATH=

# Запускать агент от имени пользователя / через sudo (Linux/macOS)
GLPI_USER=
GLPI_USE_SUDO=False

# Предварительный HTTP GET к принтеру перед SNMP-опросом
HTTP_CHECK=True

# Период фонового опроса (минуты) и предел очереди задач
POLL_INTERVAL_MINUTES=60
MAX_QUEUE_SIZE=10000

# Валидация счётчиков (защита от Kyocera bug)
ANOMALY_CHECK_TIME_WINDOW_HOURS=24
ANOMALY_JUMP_THRESHOLD=5000
ANOMALY_SKIP_CHECK_DAYS=30

# Автоблокировка ручного редактирования при свежем опросе (дни)
AUTO_LOCK_FRESHNESS_DAYS=7

# Ключ регистрации USB-агентов (PrinterCollector)
USB_AGENT_REGISTRATION_KEY=

################################################################################
# GLPI API (синхронизация и кросс-проверки)
################################################################################

GLPI_API_URL=
GLPI_APP_TOKEN=
# Либо user_token, либо логин/пароль
GLPI_USER_TOKEN=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_VERIFY_SSL=True
GLPI_SERIAL_FIELD_ID=5
GLPI_LABEL_SERIAL_FIELD_ID=
GLPI_CONTRACT_FIELD_NAME=
GLPI_CONTRACT_RESOURCE_NAME=
GLPI_FRESHNESS_DAYS=7

################################################################################
# OKDESK API
################################################################################

OKDESK_API_URL=https://*.okdesk.ru/api/v1
OKDESK_API_TOKEN=
OKDESK_VERIFY_SSL=True
